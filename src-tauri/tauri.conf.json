{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-plugins-code",
  "version": "0.1.0",
  "identifier": "com.tauri-plugins-code.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-plugins-code",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2OUQzQzU5MTc3QTAxOTgKUldTWUFYb1hXVHlkZGpjM1dKYW82S2VYL0JhakdmbFk2U09USnlIZUlKeXV3TGxlUlZGUzZFQUMK",
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "https://github.com/leixuewen/tauri-plugins-code/releases/latest/download/latest.json"
      ]
    },
    "cli": {
      "description": "Tauri CLI Plugin Example",
      "args": [
        {
          "name": "source",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "destination",
          "index": 2,
          "takesValue": true
        },
        {
          "name": "type",
          "short": "t",
          "takesValue": true,
          "multiple": true,
          "possibleValues": [
            "foo",
            "bar"
          ]
        },
        {
          "short": "v",
          "name": "verbose",
          "description": "Verbosity level"
        }
      ],
      "subcommands": {
        "run": {
          "description": "Run the application",
          "args": [
            {
              "name": "debug",
              "description": "Run application in debug mode"
            },
            {
              "name": "release",
              "description": "Run application in release mode"
            }
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../src/assets/tarui/**/*": "resources/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}